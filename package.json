{
  "name": "geo-workbench",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "node scripts/build-portable.mjs",
    "start": "node --env-file-if-exists=.env dist/server/server/node-server.js",
    "test": "node scripts/build-portable.mjs && node --test tests/core.test.mjs tests/portable.test.mjs tests/observations.test.mjs tests/identity.test.mjs",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
