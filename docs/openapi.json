{
  "openapi": "3.1.0",
  "info": {
    "title": "GEO Workbench API",
    "version": "0.2.1",
    "description": "Standalone edition: loopback-only local owner identity or HTTP Basic authentication over HTTPS. Same-origin browser writes required. Original Sites adapter uses trusted platform identity."
  },
  "paths": {
    "/api/v1/clients": {
      "get": {
        "summary": "List up to 100 clients owned by the current user",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Origin denied"
          },
          "404": {
            "description": "Client not found"
          },
          "503": {
            "description": "Storage unavailable"
          }
        }
      },
      "post": {
        "summary": "Create a client",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Origin denied"
          },
          "404": {
            "description": "Client not found"
          },
          "503": {
            "description": "Storage unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClient"
              }
            }
          }
        }
      }
    },
    "/api/v1/clients/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Client detail with latest 200 audits and observations",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Origin denied"
          },
          "404": {
            "description": "Client not found"
          },
          "503": {
            "description": "Storage unavailable"
          }
        }
      }
    },
    "/api/v1/clients/{id}/audits": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Analyze imported HTML and save immutable audit",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Origin denied"
          },
          "404": {
            "description": "Client not found"
          },
          "503": {
            "description": "Storage unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportAudit"
              }
            }
          }
        }
      }
    },
    "/api/v1/clients/{id}/observations": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Import up to 20 genuine observations",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Origin denied"
          },
          "404": {
            "description": "Client not found"
          },
          "503": {
            "description": "Storage unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportObservations"
              }
            }
          }
        }
      }
    },
    "/api/v1/providers": {
      "get": {
        "summary": "List public provider configuration (never API keys)",
        "responses": {
          "200": {
            "description": "ProviderInfo[] with id, label, model, configured"
          },
          "401": {
            "description": "Sign in required"
          }
        }
      }
    },
    "/api/v1/clients/{id}/observation-runs": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Run one paid web-search observation; replay completed requests using the same requestId",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "prompt",
                  "requestId"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 2000
                  },
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved Observation, source ai-provider; optional annotations and providerResponseId"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Origin denied"
          },
          "404": {
            "description": "Client not found"
          },
          "409": {
            "description": "Request ID conflict or already running"
          },
          "429": {
            "description": "Concurrency or provider quota limit"
          },
          "502": {
            "description": "Provider failed; no observation saved"
          },
          "503": {
            "description": "Provider not configured"
          }
        }
      }
    },
    "/api/v1/clients/{id}/identity": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Update public brand name and explicit aliases while preserving the client and evidence",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "brandAliases"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "brandAliases": {
                    "type": "array",
                    "maxItems": 10,
                    "items": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 100
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated Client"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Origin denied"
          },
          "404": {
            "description": "Client not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateClient": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "domain",
          "industry",
          "market",
          "products",
          "competitors"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "domain": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "HTTP(S), no embedded credentials"
          },
          "industry": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "market": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "products": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "competitors": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        }
      },
      "ImportAudit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "html"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "HTTP(S), no embedded credentials"
          },
          "html": {
            "type": "string",
            "minLength": 20,
            "maxLength": 250000
          }
        }
      },
      "ImportObservations": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "surface",
            "model",
            "prompt",
            "response",
            "citations",
            "observedAt"
          ],
          "properties": {
            "engine": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "surface": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "prompt": {
              "type": "string",
              "minLength": 5,
              "maxLength": 2000
            },
            "response": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "citations": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048,
                "description": "HTTP(S), no embedded credentials"
              }
            },
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "description": "UTC ISO datetime, cannot be future"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
