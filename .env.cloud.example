# Copy to .env on the VM. Replace every REPLACE_ value before starting.
GEO_AUTH_MODE=users
GEO_SUPERADMIN_EMAIL=you@yourcompany.com
GEO_SUPERADMIN_PASSWORD=REPLACE_WITH_16_PLUS_RANDOM_CHARACTERS
# Keeps data created before users mode (the old GEO_ADMIN_USERNAME) visible to the Super Admin.
GEO_DATA_OWNER=admin
# Emergency account that works even if the user table is damaged. Different from the Super Admin, 20+ characters. Remove both lines to disable.
GEO_BACKDOOR_USER=breakglass
GEO_BACKDOOR_PASSWORD=REPLACE_WITH_20_PLUS_RANDOM_CHARACTERS
GEO_ALLOWED_ORIGINS=https://geo.your-domain.com
GEO_PUBLIC_URL=https://geo.your-domain.com
GEO_PUBLIC_HOST=geo.your-domain.com
# Caddy sets X-Forwarded-For; trust it so sign-in throttling sees the real client address.
GEO_TRUST_PROXY=true
# Email for invitations. Use smtp on a server (local mode is refused when NODE_ENV=production).
GEO_MAIL_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="AI Search Intelligence <no-reply@your-domain.com>"
