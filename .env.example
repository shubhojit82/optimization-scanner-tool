# Mac development only. Local mode binds to loopback and has no password.
GEO_AUTH_MODE=local
GEO_LOCAL_USER=local-admin
GEO_BIND=127.0.0.1
PORT=8080
GEO_DATA_DIR=./data
GEO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --- Optional: sign-in page with users, access requests and per-client access ---
# Uncomment to try it locally. With GEO_AUTH_MODE=users the app shows the sign-in page.
# GEO_AUTH_MODE=users
# GEO_SUPERADMIN_EMAIL=you@yourcompany.com
# GEO_SUPERADMIN_PASSWORD=REPLACE_WITH_16_PLUS_RANDOM_CHARACTERS
# Existing data belongs to this owner name. Set it to your old GEO_LOCAL_USER / GEO_ADMIN_USERNAME to keep seeing it.
# GEO_DATA_OWNER=local-admin
# Optional emergency account that does not depend on the user table. Use a different, 20+ character password.
# GEO_BACKDOOR_USER=breakglass
# GEO_BACKDOOR_PASSWORD=REPLACE_WITH_20_PLUS_RANDOM_CHARACTERS
# Email (invitations and access decisions). GEO_MAIL_MODE picks one:
#   off   nothing is sent; the admin gets the invite link to pass on (default when SMTP_HOST is unset)
#   local nothing is sent; messages are saved and shown in Users > Email. For trying it on your machine.
#   smtp  real delivery through the SMTP server below. Use this on a server.
# GEO_MAIL_MODE=local
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AI Search Intelligence <no-reply@example.com>"
